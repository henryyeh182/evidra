{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fitness-mcp/tools/get_semantic_fitness_state.output",
  "title": "get_semantic_fitness_state output",
  "type": "object",
  "properties": {
    "userId": { "type": "string" },
    "date": { "type": "string" },
    "timezone": { "type": "string" },
    "recoveryScore": { "type": "number" },
    "readinessScore": { "type": "number" },
    "fatigueScore": { "type": "number" },
    "sleepQuality": { "type": "number" },
    "trainingLoad7d": { "type": "number" },
    "trainingLoad28d": { "type": "number" },
    "acuteChronicWorkloadRatio": { "type": "number" },
    "muscleFatigue": { "type": "object", "additionalProperties": { "type": "number" } },
    "recommendedFocus": { "type": "string" },
    "avoid": { "type": "array", "items": { "type": "string" } },
    "availableTimeMinutes": { "type": "number" },
    "goalAlignment": {
      "type": "object",
      "properties": {
        "primaryGoal": { "type": "string" },
        "score": { "type": "number" }
      },
      "required": ["primaryGoal", "score"]
    },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "reasoning": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "userId", "date", "timezone", "recoveryScore", "readinessScore", "fatigueScore",
    "muscleFatigue", "recommendedFocus", "avoid", "availableTimeMinutes",
    "goalAlignment", "confidence", "reasoning"
  ]
}
