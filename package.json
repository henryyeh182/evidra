{
  "name": "fitness-mcp",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Semantic Fitness Layer exposed through MCP for model-agnostic AI fitness coaching.",
  "scripts": {
    "demo:semantic-state": "node scripts/generate-semantic-state.js",
    "demo:mcp": "node scripts/demo-mcp-tools.js",
    "demo:knowledge": "node scripts/demo-knowledge.js",
    "demo:planning": "node scripts/demo-planning.js",
    "demo:strava": "node scripts/demo-strava-normalization.js",
    "simulate:garmin": "node scripts/simulate-garmin-scenarios.js",
    "simulate:apple-health": "node scripts/simulate-apple-health-scenarios.js",
    "simulate:google-health": "node scripts/simulate-google-health-scenarios.js",
    "simulate:strava": "node scripts/simulate-strava-scenarios.js",
    "simulate:oura": "node scripts/simulate-oura-scenarios.js",
    "simulate:whoop": "node scripts/simulate-whoop-scenarios.js",
    "replay:host-handoff": "node scripts/replay-host-handoff.js",
    "harness:substitution": "node harness/substitution-runner.js",
    "import:apple-health": "node scripts/import-apple-health.js",
    "import:google-health-api": "node scripts/import-google-health-api.js",
    "build:bundle": "node scripts/build-bundle.js",
    "pack": "npm run build:bundle && npx --yes @anthropic-ai/mcpb pack . dist/pacevera.mcpb && node scripts/stamp-release.js",
    "build:graph": "node scripts/build-exercise-graph.js",
    "audit:graph": "node scripts/audit-exercise-graph.js",
    "eval": "node eval/runner.js",
    "harness": "node harness/runner.js",
    "regression:gate": "node scripts/regression-gate.js",
    "harness:plan": "node harness/plan-runner.js",
    "test": "node --test",
    "serve:http": "node apps/mcp-server/src/http.js",
    "serve:local": "node apps/local-engine/src/stdio.js",
    "smoke:release-install": "node scripts/smoke-release-install.js",
    "review:phase": "node scripts/review-phase.js",
    "review:release": "node scripts/review-release.js",
    "test:rules": "node --test \"packages/rules/test/*.test.js\"",
    "validate:rule-packages": "node scripts/validate-rule-packages.js",
    "package:validate": "node scripts/rule-package.js validate",
    "package:dry-run": "node scripts/rule-package.js dry-run",
    "package:install": "node scripts/rule-package.js install",
    "package:rollback": "node scripts/rule-package.js rollback",
    "test:governance": "node --test packages/governance/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
