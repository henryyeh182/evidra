{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pacevera.dev/schemas/rule-review.schema.json",
  "title": "Pacevera rule package review",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reviewer", "reviewedAt", "proposedBy", "independentReview", "scope", "regression"],
  "properties": {
    "status": { "enum": ["approved", "rejected", "needs_changes"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "proposedBy": { "type": "string", "minLength": 1 },
    "independentReview": { "type": "boolean" },
    "scope": { "type": "string", "minLength": 1 },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "baseline", "cases", "decisionDiffs", "graphDiffs"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "baseline": { "type": "string", "minLength": 1 },
        "cases": { "type": "integer", "minimum": 0 },
        "decisionDiffs": { "type": "integer", "minimum": 0 },
        "graphDiffs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
