# Remote MCP readiness configuration. This file contains no credentials.
# Hosted mode starts only when all required values below are supplied.

MCP_HOST=127.0.0.1
PORT=8787
MCP_ENDPOINT=/mcp

# Must be the canonical HTTPS MCP endpoint, not just the hostname.
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_TLS_KEY_PATH=/run/secrets/mcp-tls-key.pem
MCP_TLS_CERT_PATH=/run/secrets/mcp-tls-cert.pem

# External authorization-server metadata. Pacevera is only the OAuth resource
# server; it does not issue tokens or accept provider refresh tokens.
MCP_OAUTH_AUTHORIZATION_SERVER=https://auth.example.com
MCP_OAUTH_ISSUER=https://auth.example.com/
MCP_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_OAUTH_SCOPES=fitness.decide
MCP_OAUTH_REQUIRED_SCOPES=fitness.decide
MCP_OAUTH_ALGORITHMS=RS256,PS256,ES256,EdDSA

# Comma-separated browser origins. Leave empty for non-browser MCP clients;
# never use '*' in a production browser deployment.
MCP_ALLOWED_ORIGINS=

# There is intentionally no MCP_TOKEN in hosted mode. The shared bearer token
# is only a loopback/local-development affordance.
