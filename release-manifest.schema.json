{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pacevera release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseVersion",
    "engineVersion",
    "libraryVersion",
    "libraryChecksum",
    "activeRulePackages",
    "gitCommit",
    "imageDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "engineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "libraryVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "libraryChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "activeRulePackages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "version", "contentChecksum", "engineCompatibility"],
        "properties": {
          "packageId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "contentChecksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "engineCompatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
              "max": { "type": "string", "pattern": "^<[0-9]+\\.[0-9]+\\.[0-9]+$" }
            }
          }
        }
      }
    },
    "gitCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "imageDigest": { "type": ["string", "null"] }
  }
}
